[node name="Note_A" type="Node2D" parent="World/Entities" unique_id=798874655 instance=ExtResource("11_te2ga")]
position = Vector2(-384, 272)
script = ExtResource("12_sela5")
title = "Entrance Hall"
text = "Steps climb back up to daylight. The air smells of dust and old smoke, and somewhere a cold draught seeps through the stonework."
size = Vector2i(8, 7)

[node name="Lore_A_0" type="Node2D" parent="World/Entities" unique_id=629313131 instance=ExtResource("13_d7qug")]
position = Vector2(-432, 303)
script = ExtResource("14_skrxy")
kind = 2
title = "A Miner's Last Letter"
text = "To my Hanna, if this finds you. We broke through into old halls under the silver seam: carved stone, older than Harrowmere. Foreman Grell called it luck. Then the cold came up the stair, and the lamps went blue, and the dead in the crypts began to knock. I hear the others below, walking. They don't answer to their names. Tell the boy his father was not afraid. That is a lie, but tell him anyway.
Your Tobin."
flag = "tobin_letter"

